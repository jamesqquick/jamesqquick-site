---
import { PortableText } from "emdash/ui";
import Section from "@components/Section.astro";
import SectionHeader from "@components/SectionHeader.astro";
import BlogCode from "@components/BlogCode.astro";
import BlogBlock from "@components/BlogBlock.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPostLayout from "../../layouts/BlogPostLayout.astro";
import { getBlogPostBySlug } from "../../utils/emdash-blog";
import { skipSharedCache } from "../../utils/route-cache";

export const prerender = false;

const slug = Astro.params.slug;
const { entry, isPreview, cacheHint } = slug
  ? await getBlogPostBySlug(slug)
  : { entry: null, isPreview: false, cacheHint: {} };

if (entry) {
  if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
} else {
  Astro.response.status = 404;
  skipSharedCache(Astro);
}
---

{
  entry ? (
    <BlogPostLayout post={entry} isPreview={isPreview}>
      <PortableText
        value={entry.data.content ?? []}
        components={{
          block: BlogBlock,
          type: { code: BlogCode },
        }}
      />
    </BlogPostLayout>
  ) : (
    <BaseLayout title="404 | James Q Quick">
      <Section>
        <SectionHeader
          title="404"
          subtitle="The page you are looking for does not exist"
          variant="secondary"
        />
      </Section>
    </BaseLayout>
  )
}
