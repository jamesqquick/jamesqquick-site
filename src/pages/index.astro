---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkExperience from "../components/WorkExperience.astro";
import SocialCallout from "../components/SocialCallout.astro";
import CoursesCallout from "../components/CoursesCallout.astro";
import HomeSpeakingShowcase from "../components/HomeSpeakingShowcase.astro";
import HomeTopics from "../components/HomeTopics.astro";
import Testimonials from "../components/Testimonials.astro";
import ConferenceLogos from "../components/ConferenceLogos.astro";
import FooterCta from "../components/FooterCta.astro";
import Button, { ButtonType } from "../components/Button.astro";
import speakingHero from "../images/speaking/info-bip-shift-23/speaking-hero-stage-2.png";

export const prerender = true;
---

<BaseLayout>
  <Hero
    title={`Hi. I'm James Q Quick.`}
    tagline={"International keynote speaker on AI and developer experience."}
    description={"Helping engineering teams ship faster with AI, and helping developers stay relevant in an AI-first world."}
    image={speakingHero}
    imageAlt="James Q Quick speaking on stage at a conference"
  >
    <div class="flex flex-wrap gap-4 mt-6">
      <Button
        text="Book me to speak"
        href="/speaking#speakerForm"
        isLink
        type={ButtonType.PRIMARY}
      />
      <Button
        text="Watch a keynote"
        href="https://www.youtube.com/watch?v=DajdLKD0OmQ"
        isLink
        newTab
        type={ButtonType.SECONDARY}
      />
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-6 text-sm text-textMuted">
      <span>Cloudflare</span>
      <span class="hidden sm:inline opacity-40">·</span>
      <span>ex-Microsoft, Auth0, PlanetScale</span>
      <span class="hidden sm:inline opacity-40">·</span>
      <span>250k+ developers</span>
    </div>
  </Hero>
  <SocialCallout />
  <HomeSpeakingShowcase />
  <HomeTopics />
  <Testimonials />
  <WorkExperience />
  <CoursesCallout />
  <ConferenceLogos />
  <FooterCta />
</BaseLayout>
