---
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkCardList from "../components/LinkCardList.astro";
import Section from "../components/Section.astro";
import HeroSection from "@components/HeroSection.astro";
import {
  getBlogPostDate,
  getBlogPostPath,
  getBlogSlug,
  getPublishedBlogPosts,
} from "../utils/emdash-blog";

export const prerender = false;

const posts = await getPublishedBlogPosts(50);
const formattedPosts = posts.map((post) => {
  const slug = getBlogSlug(post);
  return {
    id: slug,
    title: post.data.title,
    date: getBlogPostDate(post),
    description: post.data.excerpt,
    tags: post.data.tags ?? [],
    link: getBlogPostPath(slug),
  };
});
---

<BaseLayout title="Blog | James Q Quick">
  <HeroSection
    title="Blog"
    hasFullHeight={false}
    size="large"
    classStr="pt-10 pb-4 md:pt-12 md:pb-6 lg:pt-14 lg:pb-8"
    subtitle="Articles for web developers!"
    description="I write about modern web development, developer experience, careers, and more!"
    h1AriaLabel="Blog | James Q Quick"
  />
  <!-- <Section tone="elevated" paddingY="default">
    <FeaturedSplitSection
    image={featuredPost.data.coverImage}
    title={featuredPost.data.title}
    description={featuredPost.data.description}
    href={featuredPost.data.link}
    date={featuredPost.data.pubDate}
  />
  </Section> -->
  <Section tone="base" paddingY="compact">
    <LinkCardList items={formattedPosts} />
  </Section>
</BaseLayout>
