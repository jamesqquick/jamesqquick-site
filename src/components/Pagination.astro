---
import Button from "./Button.astro";

export interface Props {
  currentPage: number;
  next?: string;
  prev?: string;
  ariaLabel?: string;
}

const { currentPage, next, prev, ariaLabel = "Pagination" } = Astro.props;
---

{
  (prev || next) && (
    <nav
      aria-label={ariaLabel}
      class="grid grid-cols-2 items-center gap-3 sm:grid-cols-[1fr_auto_1fr]"
    >
      <div class="col-start-1 row-start-2 justify-self-start sm:row-start-1">
        {prev && <Button text="Previous" isLink={true} href={prev} />}
      </div>
      <span
        aria-current="page"
        class="col-span-2 col-start-1 row-start-1 text-center text-text-muted sm:col-span-1 sm:col-start-2"
      >
        Page {currentPage}
      </span>
      <div class="col-start-2 row-start-2 justify-self-end sm:col-start-3 sm:row-start-1">
        {next && <Button text="Next" isLink={true} href={next} />}
      </div>
    </nav>
  )
}
