---
import { getSortedBlogPosts } from "../utils/contentCollections";
import LinkCardList from "./LinkCardList.astro";
import Section from "../components/Section.astro";
const posts = (await getSortedBlogPosts()).slice(0, 2).map((post) => ({
  ...post.data,
  id: post.id,
  date: post.data.pubDate,
  link: `/blog/${post.id}`,
}));
---

<Section>
  <div>
    <LinkCardList items={posts} />
  </div>
</Section>
