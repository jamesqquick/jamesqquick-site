---
import ArticleHeader from "../components/ArticleHeader.astro";
import BaseLayout from "./BaseLayout.astro";
import Section from "@components/Section.astro";
import CopyPromptButton from "@components/CopyPromptButton.astro";
import BlogContent from "../components/BlogContent.astro";
import {
  getBlogPostDate,
  getBlogPostPath,
  getBlogSlug,
  resolveBlogImageUrl,
  type BlogEntry,
} from "../utils/emdash-blog";

export interface Props {
  post: BlogEntry;
  isPreview?: boolean;
}

const { post, isPreview = false } = Astro.props as Props;
const { title, excerpt, featured_image, youtube_video_id } = post.data;
const postUrl = new URL(getBlogPostPath(getBlogSlug(post)), Astro.site).href;
const imageUrl = resolveBlogImageUrl(
  featured_image,
  Astro.locals.emdash?.getPublicMediaUrl
);
---

<BaseLayout
  title={title}
  description={excerpt}
  image={imageUrl}
  canonicalUrl={postUrl}
  noIndex={isPreview}
>
  <Section>
    <article class="ds-prose">
      <ArticleHeader
        title={title}
        date={getBlogPostDate(post)}
        youTubeVideoId={youtube_video_id}
      />
      <CopyPromptButton url={postUrl} />
      <BlogContent><slot /></BlogContent>
    </article>
  </Section>
</BaseLayout>
